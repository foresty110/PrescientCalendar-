# 로컬 개발용. docker-compose 의 postgres 와 매칭.
# 프로덕션(Vercel)에 입력할 값은 docs/deploy.md 참조.
# .env 는 절대 커밋 X (gitignore 대상).

# ─── 데이터베이스 ────────────────────────────────────────────────────────────
# 로컬: docker compose up -d 로 띄운 postgres
# 프로덕션: Neon 콘솔의 connection string (sslmode=require 포함)
DATABASE_URL="postgresql://prescient:prescient@localhost:5432/prescient?schema=public"

# ─── Anthropic Claude API ───────────────────────────────────────────────────
# https://console.anthropic.com/ → API Keys 에서 발급
ANTHROPIC_API_KEY=""

# ─── Auth.js v5 ─────────────────────────────────────────────────────────────
# AUTH_SECRET: openssl rand -base64 32 로 생성. 환경별로 다른 값 권장.
AUTH_SECRET=""

# 로컬은 AUTH_URL 명시. 프로덕션(Vercel)에선 AUTH_URL 대신 AUTH_TRUST_HOST=true
# 를 사용 → preview 배포 등 가변 URL 자동 대응.
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"   # Vercel 에서만 활성

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# 콜백 URL:
#   - 로컬: http://localhost:3000/api/auth/callback/google
#   - 프로덕션: https://<your-app>.vercel.app/api/auth/callback/google
# 둘 다 같은 OAuth 클라이언트에 등록 가능 (또는 환경별 분리)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
