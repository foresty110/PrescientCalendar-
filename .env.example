# 로컬 개발용. docker-compose의 postgres에 맞춤.
DATABASE_URL="postgresql://prescient:prescient@localhost:5432/prescient?schema=public"

# Anthropic Claude API
ANTHROPIC_API_KEY=""

# Auth.js v5
# AUTH_SECRET: openssl rand -base64 32 로 생성
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console에서 발급)
# 콜백 URL: http://localhost:3000/api/auth/callback/google
# 배포 시 prod URL 콜백도 추가
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
