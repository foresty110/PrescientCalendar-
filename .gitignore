*.iml

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
# next-env.d.ts 는 next dev / next build 가 매번 덮어쓰는 자동 생성 파일.
# Next.js 공식이 "should not be edited" 라고 명시하고 create-next-app 기본 템플릿도 ignore.
# dev 와 build 가 서로 다른 generated types 경로(.next/dev/types vs .next/types)를
# 가리키도록 한 줄을 토글하므로, 추적하면 PR diff 노이즈가 계속 생긴다.
next-env.d.ts

# 환경 변수
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# 로그·캐시
*.log
.DS_Store
coverage/
playwright-report/
test-results/
.turbo/

# Prisma
prisma/*.db
prisma/migrations/dev-*/

# TS incremental build cache
*.tsbuildinfo

# OpenAPI 생성물은 커밋 (포트폴리오 가시성 위해)
# openapi.json — 커밋 OK
.vercel

# Vercel env 셋업 스크립트 — 실제 토큰·시크릿 채워진 파일은 커밋 금지 (.example 만 커밋)
scripts/setup-vercel-env-*.sh
!scripts/setup-vercel-env-*.sh.example

