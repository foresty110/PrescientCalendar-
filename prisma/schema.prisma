generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Auth.js v5 표준 테이블 (Prisma 어댑터)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  events        Event[]
  scheduledRuns ScheduledRun[]
  actualRuns    ActualRun[]
  predictions   Prediction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// 도메인 — 모든 row에 userId FK + @@index([userId])
// =============================================================================

model Event {
  id                  String    @id @default(cuid())
  userId              String
  title               String
  recurrence          Json?     // { freq, byDay?, until? }
  defaultDurationMin  Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledRuns  ScheduledRun[]
  predictions    Prediction[]   @relation("PredictionBasis")

  @@index([userId])
}

model ScheduledRun {
  id                        String    @id @default(cuid())
  userId                    String
  eventId                   String
  scheduledStartAt          DateTime
  scheduledDurationMin      Int
  feasibilityScore          Int?
  feasibilityModelVersion   String?
  feasibilityComputedAt     DateTime?
  createdAt                 DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actualRun ActualRun?

  @@index([userId])
  @@index([userId, scheduledStartAt])
  @@index([eventId])
}

enum ActualRunStatus {
  done
  skipped
  late
}

model ActualRun {
  id                String           @id @default(cuid())
  userId            String
  scheduledRunId    String           @unique
  actualStartAt     DateTime
  actualDurationMin Int
  status            ActualRunStatus
  createdAt         DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledRun ScheduledRun @relation(fields: [scheduledRunId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, actualStartAt])
}

enum PredictionStatus {
  pending
  accepted
  rejected
}

model Prediction {
  id               String           @id @default(cuid())
  userId           String
  suggestedStartAt DateTime
  suggestedDurationMin Int
  title            String
  basisEventId     String?
  feasibility      Int?
  status           PredictionStatus @default(pending)
  createdAt        DateTime         @default(now())

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  basisEvent Event? @relation("PredictionBasis", fields: [basisEventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, suggestedStartAt])
}
