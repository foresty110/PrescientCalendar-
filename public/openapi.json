{
  "openapi": "3.1.0",
  "info": {
    "title": "Prescient Calendar API",
    "version": "0.1.0",
    "description": "자연어로 일정을 만들고 회고하고 실현 가능성을 평가하는 캘린더 서비스의 HTTP API. 인증은 세션 쿠키 기반(Auth.js)이며, 모든 도메인 라우트는 로그인 사용자만 접근 가능."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "로컬 개발"
    },
    {
      "url": "https://prescient-calendar.vercel.app",
      "description": "프로덕션 (배포 후)"
    }
  ],
  "tags": [
    {
      "name": "대화",
      "description": "LLM 에이전트 채팅 — 일정·회고·실현 가능성 통합"
    },
    {
      "name": "일정",
      "description": "ScheduledRun 조회"
    },
    {
      "name": "회고",
      "description": "ActualRun 기록 (UI 직접 호출 경로)"
    }
  ],
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/chat": {
      "post": {
        "tags": [
          "대화"
        ],
        "summary": "자연어로 일정 만들기·회고·실현 가능성 질의",
        "description": "> ⚠️ **이 엔드포인트는 호출당 Anthropic Claude API 비용(약 ₩1~10)이 발생합니다.**\n> 이 페이지의 try-it-out 대신 실제 채팅 UI(`/app`)에서 검증하세요. 이 섹션은 입출력 형식·예제 확인용입니다.\n\n사용자 채팅 메시지를 받아 LLM 에이전트가 도구(일정 CRUD·회고 기록·통계·실현 가능성)를 호출하고 결과를 텍스트로 응답한다. 인증 필수 (세션 쿠키).",
        "servers": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "role",
                        "content"
                      ],
                      "description": "한 턴의 대화 메시지. role과 content로 구성.",
                      "example": {
                        "role": "user",
                        "content": "내일 오후 3시 운동 1시간"
                      }
                    },
                    "minItems": 1,
                    "maxItems": 50
                  }
                },
                "required": [
                  "messages"
                ],
                "description": "지금까지의 대화 메시지 전체. 서버가 일정 잡기·회고·실현 가능성 모드를 자동 라우팅한다."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "정상 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "어시스턴트 최종 응답 텍스트"
                    },
                    "toolCalls": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "input": {},
                          "output": {},
                          "error": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    },
                    "stopReason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text",
                    "toolCalls",
                    "stopReason"
                  ],
                  "description": "어시스턴트 응답 + 호출된 도구 시퀀스 + 종료 사유"
                }
              }
            }
          },
          "400": {
            "description": "요청 검증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "로그인 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "내부 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "일정"
        ],
        "summary": "기간 내 일정·회고 목록 조회",
        "description": "캘린더 표시·LLM 컨텍스트용. `from`·`to`는 ISO-8601, KST offset 권장. `withActualRun=true`면 회고도 포함.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-05-01T00:00:00+09:00"
            },
            "required": true,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-05-31T23:59:59+09:00"
            },
            "required": true,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "withActualRun",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "정상 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "scheduledRunId": {
                            "type": "string"
                          },
                          "eventId": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "scheduledStartAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "scheduledDurationMin": {
                            "type": "integer"
                          },
                          "feasibilityScore": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "actualRun": {
                            "type": "object",
                            "properties": {
                              "actualStartAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "actualDurationMin": {
                                "type": "integer"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "done",
                                  "skipped",
                                  "late"
                                ]
                              }
                            },
                            "required": [
                              "actualStartAt",
                              "actualDurationMin",
                              "status"
                            ]
                          }
                        },
                        "required": [
                          "scheduledRunId",
                          "eventId",
                          "title",
                          "scheduledStartAt",
                          "scheduledDurationMin",
                          "feasibilityScore"
                        ],
                        "description": "한 ScheduledRun과 (요청 시) 회고 정보"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "description": "from~to 범위 ScheduledRun 목록"
                }
              }
            }
          },
          "400": {
            "description": "쿼리 검증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "로그인 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/retros": {
      "post": {
        "tags": [
          "회고"
        ],
        "summary": "캘린더 모달에서 회고 직접 입력",
        "description": "채팅 도구(`record_actual_run`)와 동일한 핸들러를 호출. UI에서 LLM 비용 없이 직접 저장하는 경로.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scheduledRunId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actualStartAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-05-12T07:15:00+09:00"
                  },
                  "actualDurationMin": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 720
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "done",
                      "skipped",
                      "late"
                    ]
                  }
                },
                "required": [
                  "scheduledRunId",
                  "actualStartAt",
                  "actualDurationMin",
                  "status"
                ],
                "description": "특정 ScheduledRun에 대한 회고 기록. 같은 ScheduledRun에 다시 보내면 갱신.",
                "example": {
                  "scheduledRunId": "cmp...",
                  "actualStartAt": "2026-05-12T07:15:00+09:00",
                  "actualDurationMin": 25,
                  "status": "late"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "정상 응답 (UPSERT 결과)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actualRunId": {
                      "type": "string"
                    },
                    "scheduledRunId": {
                      "type": "string"
                    },
                    "actualStartAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "actualDurationMin": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "done",
                        "skipped",
                        "late"
                      ]
                    }
                  },
                  "required": [
                    "actualRunId",
                    "scheduledRunId",
                    "actualStartAt",
                    "actualDurationMin",
                    "status"
                  ],
                  "description": "저장(또는 갱신)된 회고"
                }
              }
            }
          },
          "400": {
            "description": "본문 검증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "로그인 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "다른 사용자 일정에 회고 시도 (IDOR 차단)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}